{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "Run SyndromeOS",
            "type": "shell",

            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\run.ps1"
            ],

            "options": {
                "cwd": "${workspaceFolder}"
            },

            "group": {
                "kind": "build",
                "isDefault": true
            },

            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },

            "problemMatcher": []
        }
    ]
}